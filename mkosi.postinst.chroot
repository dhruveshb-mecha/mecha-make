#!/bin/bash
set -e

# --- mkosi.postinst.chroot Wrapper ---
# This script executes all modules in the skeleton directory in numerical order.

# Set a standard PATH for chroot operations
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

SCRIPT_DIR="/usr/local/lib/mkosi-postinst.d"

# Only run if we are in the main image phase (initrd won't have package managers)
if [ ! -f /usr/bin/apt ] && [ ! -f /usr/bin/dpkg ]; then
    echo "--- Skipping modular postinst (initrd phase) ---"
    exit 0
fi

if [ -d "$SCRIPT_DIR" ]; then
    for script in "$SCRIPT_DIR"/*.sh; do
        if [ -x "$script" ]; then
            echo "--- Executing: $(basename "$script") ---"
            "$script"
        fi
    done
    
    # Clean up build-only scripts after successful execution
    echo "--- Cleaning up modular post-install scripts ---"
    rm -rf "$SCRIPT_DIR"
else
    echo "Error: $SCRIPT_DIR not found inside chroot."
    exit 1
fi
